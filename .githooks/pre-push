#!/bin/sh
set -e

if [ -n "$PYTHON_BIN" ]; then
  PY="$PYTHON_BIN"
elif [ -x "../venv_mianshi/Scripts/python.exe" ]; then
  PY="../venv_mianshi/Scripts/python.exe"
elif [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
else
  PY="python"
fi

"$PY" scripts/check_docstrings.py
"$PY" -m ruff check .
"$PY" -m pytest -q
